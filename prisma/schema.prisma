// Prisma schema for Pedagogical Scripts Database (ClassUp)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  password     String
  role         String        @default("TEACHER") // ADMIN or TEACHER
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  scripts      Script[]
  ratings      Rating[]
  comments     Comment[]
  savedScripts SavedScript[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  scripts     Script[]
}

model Script {
  id          String        @id @default(cuid())
  title       String
  situation   String
  content     String
  methodTip   String?
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ratings     Rating[]
  comments    Comment[]
  savedBy     SavedScript[]
}

model Rating {
  id        String   @id @default(cuid())
  value     Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, scriptId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SavedScript {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, scriptId])
}
